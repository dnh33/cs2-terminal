# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND ENV — used by Vite at build time. Copy to .env (gitignored).
# ─────────────────────────────────────────────────────────────────────────────
# Anything prefixed VITE_ gets compiled into the public bundle. Never put
# secrets here. Real secrets (API keys, admin tokens, Steam cookies) live
# server-side as Cloudflare Worker secrets — see worker/.dev.vars.example.

# URL of the deployed Cloudflare Worker (no trailing slash).
#   Local dev:    http://localhost:8787
#   Production:   https://cs2-steam-proxy.<your-account>.workers.dev
VITE_WORKER_URL=http://localhost:8787
